{{define "versions-dl"}}<dl class="meta">{{range $k := versions .}}<dt>{{$k}}</dt><dd class="mono">{{index $ $k}}</dd>{{end}}</dl>{{end}}

{{define "validation-body"}}{{$v := .}}
<div class="card">
  <p class="verdict">Verdict: <span class="badge {{verdictClass $v.Verdict}}">{{$v.Verdict}}</span> <span class="muted">{{counts $v}} in {{len $v.Files}} file(s)</span></p>
  <dl class="meta">
    <dt>Validation</dt><dd class="mono">{{$v.ID}}</dd>
    {{if $v.Label}}<dt>Label</dt><dd>{{$v.Label}}</dd>{{end}}
    <dt>Started</dt><dd>{{ts $v.Created}}</dd>
    <dt>Finished</dt><dd>{{if $v.Running}}running…{{else}}{{ts $v.Finished}}{{end}}</dd>
  </dl>
</div>
{{range $v.Files}}
<div class="card">
  <h2><span class="badge {{verdictClass .Verdict}}">{{.Verdict}}</span> <span class="mono">{{.Name}}</span></h2>
  {{if .EngineErrors}}<p class="sev-error">Engine errors (the file could not be fully checked, so it fails):</p>
  <ul>{{range .EngineErrors}}<li><b>{{.Engine}}</b>: {{.Message}}</li>{{end}}</ul>{{end}}
  {{if .Findings}}
  <table><tr><th>Severity</th><th>Engine</th><th>Attribute</th><th>Message</th></tr>
  {{range .Findings}}<tr><td class="sev-{{.Severity}}">{{.Severity}}</td><td>{{.Engine}}</td><td class="mono">{{.Path}}</td><td>{{.Message}}</td></tr>{{end}}
  </table>
  {{else}}{{if not .EngineErrors}}<p class="pass">No findings.</p>{{end}}{{end}}
  {{if .Raw}}<details><summary>Raw engine output</summary>{{range $k, $r := .Raw}}<p><b>{{$k}}</b></p><pre>{{$r}}</pre>{{end}}</details>{{end}}
</div>
{{end}}
<div class="card">
  <h2>Consistency across files (dcentvfy)</h2>
  {{if $v.SetErrors}}<ul>{{range $v.SetErrors}}<li class="sev-error"><b>{{.Engine}}</b>: {{.Message}}</li>{{end}}</ul>{{end}}
  {{if $v.SetFindings}}<table><tr><th>Severity</th><th>Message</th></tr>
  {{range $v.SetFindings}}<tr><td class="sev-{{.Severity}}">{{.Severity}}</td><td>{{.Message}}</td></tr>{{end}}</table>
  {{else}}{{if not $v.SetErrors}}<p class="pass">No inconsistencies found.</p>{{end}}{{end}}
  {{if $v.SetRaw}}<details><summary>Raw output</summary><pre>{{$v.SetRaw}}</pre></details>{{end}}
</div>
<div class="card"><h2>Versions</h2>{{template "versions-dl" $v.Versions}}</div>
{{end}}

{{define "run-body"}}{{$r := .}}
<div class="card">
  <p class="verdict">Verdict: <span class="badge {{verdictClass $r.Verdict}}">{{if $r.Running}}running…{{else}}{{$r.Verdict}}{{end}}</span></p>
  {{if $r.Error}}<p class="sev-error">{{$r.Error}}</p>{{end}}
  <dl class="meta">
    <dt>Plan</dt><dd>{{$r.Plan}}</dd>
    <dt>Plan SHA-256</dt><dd class="mono">{{$r.PlanSHA256}}</dd>
    <dt>Target</dt><dd>{{if $r.TargetDesc}}{{$r.TargetDesc}}{{else}}{{$r.Target}}{{end}}</dd>
    <dt>Run</dt><dd class="mono">{{$r.ID}}</dd>
    <dt>Started</dt><dd>{{ts $r.Started}}</dd>
    <dt>Finished</dt><dd>{{if $r.Running}}running…{{else}}{{ts $r.Finished}}{{end}}</dd>
  </dl>
</div>
<table>
  <tr><th>Step</th><th>Type</th><th>Verifies</th><th>Result</th><th>Details</th><th>Time</th></tr>
  {{range $r.Steps}}
  <tr><td class="mono">{{.ID}}</td><td>{{.Type}}</td><td class="mono">{{join .Verifies ", "}}</td>
    <td><span class="badge {{stepClass .Status}}">{{.Status}}</span></td>
    <td>{{range .Messages}}<div>{{.}}</div>{{end}}</td><td>{{dur .Duration}}</td></tr>
  {{end}}
</table>
{{range $r.Steps}}{{if .Validation}}
<h2>Step {{.ID}}: object validation</h2>
{{template "validation-body" .Validation}}
{{end}}{{end}}
<div class="card"><h2>Versions</h2>{{template "versions-dl" $r.Versions}}</div>
{{end}}

{{define "run-page"}}<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>LibreDVT report: {{.Run.Plan}}</title><style>{{.CSS}}</style></head>
<body><main>
<h1>LibreDVT test report: {{.Run.Plan}}</h1>
{{template "run-body" .Run}}
<footer>Generated by LibreDVT. Test data only: this report must not contain patient data.</footer>
</main></body></html>{{end}}

{{define "validation-page"}}<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>LibreDVT validation {{.V.ID}}</title><style>{{.CSS}}</style></head>
<body><main>
<h1>LibreDVT validation report</h1>
{{template "validation-body" .V}}
<footer>Generated by LibreDVT. Test data only: this report must not contain patient data.</footer>
</main></body></html>{{end}}
