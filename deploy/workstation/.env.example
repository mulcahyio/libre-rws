# Libre DCM - workstation settings
# Libre RWS (Radiology Workflow System) - developed by Patrick Mulcahy, Mulcahy.io <dev@mulcahy.io>
#
# The installer copies this file to .env. Edit .env, then run the installer
# again (or `docker compose up -d`) to apply changes. Your data is kept.

# --- Identity --------------------------------------------------------------
# AE title other DICOM devices use to reach this node (max 16 chars, A-Z 0-9 _).
RWS_DICOM_AE_TITLE=RWS_DICOM
# Accept associations addressed to any called AE title (handy while testing).
RWS_DICOM_ALLOW_ANY_CALLED_AE=false
# Accept any SOP class, not just the standard storage classes.
RWS_DICOM_ACCEPT_ANY_SOP_CLASS=false
RWS_NODE_ID=workstation

# --- C-MOVE destinations ---------------------------------------------------
# Where this node may send images when a viewer/PACS asks for a C-MOVE.
# NAME=HOST:PORT[:CALLED_AE], separated by commas. NAME is the AE title the
# requester puts in the move. For a viewer on this same PC use
# host.docker.internal as the host.
#   RWS_DICOM_REMOTE_AES=VIEWER1=host.docker.internal:11113,PACS_B=192.168.1.50:104:PACSB
RWS_DICOM_REMOTE_AES=

# --- Network ---------------------------------------------------------------
# Host port for DICOM. Use 104 only if nothing else on the PC already uses it.
RWS_DICOM_PORT=11112
# Interface to listen on: 0.0.0.0 = whole network, 127.0.0.1 = this PC only.
RWS_BIND_IP=0.0.0.0
# Host port for health/metrics (always bound to 127.0.0.1).
RWS_ADMIN_PORT=8081
RWS_DICOM_MAX_ASSOCIATIONS=16

# --- Data ------------------------------------------------------------------
# Leave blank to use the Docker volume "rws-dicom-data" (recommended).
# Or give a LOCAL folder, e.g. C:/RWS/dicom-data  (forward slashes on Windows).
# Do not use a network/mapped drive: the SQLite index needs local disk.
RWS_DATA=

# --- Logging and events ----------------------------------------------------
RWS_LOG_LEVEL=info
# text is easier to read in `docker logs`; json for log collectors.
RWS_LOG_FORMAT=text
# none | log | nats   (nats also starts a local NATS server)
RWS_EVENTS_DRIVER=log
TZ=America/New_York

# --- Image -----------------------------------------------------------------
RWS_VERSION=0.1.1-beta.1
