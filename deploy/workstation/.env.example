# LibreDCM - workstation settings
# Libre RWS (Radiology Workflow System) - developed by Patrick Mulcahy, Mulcahy.io <dev@mulcahy.io>
#
# The installer copies this file to .env and asks for the install-time
# choices (storage, TLS, patient IDs). Edit .env and run `install` again, or
# run `configure` to answer the questions again. Your data is kept.
# Settings named RWS_* (LibreDCM 0.1.x) are renamed automatically.

# --- Identity --------------------------------------------------------------
# AE title other DICOM devices use to reach this node (max 16 chars, A-Z 0-9 _).
LIBRE_DCM_AE_TITLE=LIBREDCM
# Accept associations addressed to any called AE title (handy while testing).
LIBRE_DCM_ALLOW_ANY_CALLED_AE=false
# Accept any SOP class, not just the standard storage classes.
LIBRE_DCM_ACCEPT_ANY_SOP_CLASS=false
LIBRE_DCM_NODE_ID=workstation

# --- C-MOVE destinations ---------------------------------------------------
# NAME=HOST:PORT[:CALLED_AE], comma-separated. For a viewer on this PC use
# host.docker.internal as the host.
#   LIBRE_DCM_REMOTE_AES=VIEWER1=host.docker.internal:11113,PACS_B=192.168.1.50:104:PACSB
LIBRE_DCM_REMOTE_AES=

# Which peers may connect (calling AE titles). Empty = any peer that calls our
# AE title. Entries: AE, AE@IP or AE@CIDR, comma-separated.
#   LIBRE_DCM_ALLOWED_AES=CT_ROOM1@192.168.1.40,VIEWER1,MR@10.0.5.0/24
LIBRE_DCM_ALLOWED_AES=

# Admin endpoint token (the installer generates one). /metrics and /version
# need an "Authorization: Bearer" header with it; /healthz and /readyz stay open.
LIBRE_DCM_ADMIN_TOKEN=

# --- Network ---------------------------------------------------------------
# Host port for DICOM. Use 104 only if nothing else on the PC already uses it.
LIBRE_DCM_PORT=11112
# Interface to listen on: 0.0.0.0 = whole network, 127.0.0.1 = this PC only.
LIBRE_DCM_BIND_IP=0.0.0.0
# Host port for health/metrics (always bound to 127.0.0.1).
LIBRE_DCM_ADMIN_PORT=8081
LIBRE_DCM_MAX_ASSOCIATIONS=16

# --- Storage (chosen at install) -------------------------------------------
# fs = this PC (Docker volume, or the folder in LIBRE_DCM_DATA)
# s3 = AWS S3 or an S3-compatible store (MinIO, Ceph, NAS with an S3 API)
LIBRE_DCM_STORAGE_DRIVER=fs
# Local folder instead of the Docker volume, e.g. C:/LibreDCM/data (forward
# slashes on Windows). The index always lives here; with fs the images too.
# Not a network drive: the SQLite index needs local disk.
LIBRE_DCM_DATA=
LIBRE_DCM_STORAGE_S3_ENDPOINT=
LIBRE_DCM_STORAGE_S3_BUCKET=
LIBRE_DCM_STORAGE_S3_REGION=
LIBRE_DCM_STORAGE_S3_PREFIX=
LIBRE_DCM_STORAGE_S3_ACCESS_KEY=
LIBRE_DCM_STORAGE_S3_SECRET_KEY=
# true only for a lab store without HTTPS.
LIBRE_DCM_STORAGE_S3_INSECURE=false
LIBRE_DCM_STORAGE_S3_CREATE_BUCKET=false

# --- TLS (chosen at install) -----------------------------------------------
# off         = plain DICOM and admin endpoint
# self-signed = the installer creates a certificate (LIBRE_DCM_TLS_HOSTS adds
#               DNS names / IPs to it, comma-separated)
# files       = your own certificate: tls.crt and tls.key in LIBRE_DCM_TLS_DIR
LIBRE_DCM_TLS_MODE=off
LIBRE_DCM_TLS_HOSTS=
LIBRE_DCM_TLS_DIR=./tls
# Set by the installer from the mode above (paths inside the container).
LIBRE_DCM_TLS_CERT=
LIBRE_DCM_TLS_KEY=
LIBRE_DCM_ADMIN_TLS_CERT=
LIBRE_DCM_ADMIN_TLS_KEY=

# --- Patient identifiers (chosen at install) -------------------------------
# true leaves the patient ID out of event-bus messages / audit records.
LIBRE_DCM_EVENTS_OMIT_PATIENT_ID=false
LIBRE_DCM_AUDIT_OMIT_PATIENT_ID=false

# --- Patient ID conflicts (chosen at install) ------------------------------
# Images for a study already stored under another patient ID (or a series
# stored under another study): quarantine = hold for review in Libre WT,
# reject = refuse (status A778, the sender keeps them queued),
# accept_separate = store as a separate, visible study.
LIBRE_DCM_PATIENT_CONFLICT_POLICY=quarantine
# hidden = held images are not returned to viewers; flagged = returned under
# their own (possibly B000_-prefixed) patient ID.
LIBRE_DCM_PATIENT_CONFLICT_VISIBILITY=hidden
# true stores held images with patient ID "B000_" + received ID (recorded in
# the file's Original Attributes Sequence) and answers C-STORE with B000.
LIBRE_DCM_PATIENT_CONFLICT_COERCE_PATIENT_ID=false

# --- Logging and events ----------------------------------------------------
LIBRE_DCM_LOG_LEVEL=info
# text is easier to read in `docker logs`; json for log collectors.
LIBRE_DCM_LOG_FORMAT=text
# none | log | nats   (nats also starts a local NATS server)
LIBRE_DCM_EVENTS_DRIVER=log
TZ=America/New_York

# --- License (official builds) ----------------------------------------------
# Official builds need a LibreKey license locked to this PC. install asks for
# the key; for unattended installs put it here. Source builds need none.
LIBRE_DCM_LICENSE_KEY=
# host.docker.internal = this PC (a LibreKey server running locally).
LIBRE_DCM_LICENSE_SERVER=http://host.docker.internal:8090
# This PC's machine id (filled in by the installer; part of the license lock).
LIBREKEY_HOST_ID=

# --- Image -----------------------------------------------------------------
LIBRE_DCM_VERSION=0.2.0-beta.1
# official = official build (license required); empty = source build.
LIBRE_DCM_BUILD_TAGS=
LIBRE_DCM_BUILD_DATE=
